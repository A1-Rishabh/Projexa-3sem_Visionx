# Jivaka Clinic - Environment Variables Template
# Copy this file to .env and provide your credentials. Never commit your real secret keys.

# =====================================================================
# Google Sign-In Integration (OAuth 2.0 Web Client ID)
# Obtain from: https://console.cloud.google.com/apis/credentials
# =====================================================================
VITE_GOOGLE_CLIENT_ID="[Your Google OAuth 2.0 Web Client ID, e.g. 1234567890-abc.apps.googleusercontent.com]"

# =====================================================================
# Payment Gateway Configuration (Razorpay Checkout)
# Obtain from: https://dashboard.razorpay.com/#/app/keys
# =====================================================================
VITE_RAZORPAY_KEY_ID="[Your Razorpay Test Key ID, e.g. rzp_test_xxxxxxxxxx]"

